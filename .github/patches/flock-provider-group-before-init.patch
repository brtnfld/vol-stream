Flock 0.8.0 / main (7b484c5): don't dereference provider->group before
init_group() returns.

flock_provider_register() assigns p->group only after the backend's
init_group() returns, but the SWIM backend registers its RPC handlers and
then blocks announcing a join inside init_group(). A concurrently joining
member's gossip can reach process_gossip_entries() in that window, whose
member_update_callback is dispatch_member_update(), which dereferences
provider->group (still NULL) -> SIGSEGV in libflock-server.

Publish the group only once fully built, and skip the group-file write in
the dispatchers until it exists; flock_provider_register() writes the file
itself right after init_group() returns, so nothing is lost.

See https://github.com/brtnfld/vol-stream/issues/1. Drop this patch once
upstream mochi-flock includes an equivalent fix.

--- a/src/provider.c
+++ b/src/provider.c
@@ -322,10 +322,11 @@
         // LCOV_EXCL_STOP
     }
 
-    /* set the provider's group */
-    p->group = calloc(1, sizeof(*(p->group)));
-    p->group->ctx = context;
-    p->group->fn  = a.backend;
+    /* set the provider's group, fully built before it is published */
+    flock_group* group = calloc(1, sizeof(*group));
+    group->ctx = context;
+    group->fn  = a.backend;
+    __atomic_store_n(&p->group, group, __ATOMIC_RELEASE);
 
     /* Set the teardown callback. We use a PRE-finalize callback rather than a
      * finalize callback: pre-finalize callbacks run while the Margo progress
@@ -647,10 +648,13 @@
             (c->member_cb)(c->args, u, address, provider_id);
         c = c->next;
     }
-    /* write the current view of the group */
-    provider->group->fn->get_view(
-        provider->group->ctx,
-        serialize_view_to_file, provider);
+    /* write the current view of the group -- unless the backend is still
+     * inside init_group(): its RPC handlers are live by then, so a concurrent
+     * joiner's gossip can land here before provider->group is set.
+     * flock_provider_register() writes the file itself once it is. */
+    flock_group* group = __atomic_load_n(&provider->group, __ATOMIC_ACQUIRE);
+    if(group)
+        group->fn->get_view(group->ctx, serialize_view_to_file, provider);
     ABT_rwlock_unlock(provider->update_callbacks_lock);
 }
 
@@ -665,9 +669,12 @@
             (c->metadata_cb)(c->args, key, value);
         c = c->next;
     }
-    /* write the current view of the group */
-    provider->group->fn->get_view(
-        provider->group->ctx,
-        serialize_view_to_file, provider);
+    /* write the current view of the group -- unless the backend is still
+     * inside init_group(): its RPC handlers are live by then, so a concurrent
+     * joiner's gossip can land here before provider->group is set.
+     * flock_provider_register() writes the file itself once it is. */
+    flock_group* group = __atomic_load_n(&provider->group, __ATOMIC_ACQUIRE);
+    if(group)
+        group->fn->get_view(group->ctx, serialize_view_to_file, provider);
     ABT_rwlock_unlock(provider->update_callbacks_lock);
 }
